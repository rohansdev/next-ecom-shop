// use prisma-8
model User {
  id        Int                        @id @default(autoincrement())
  email     String                     @unique
  username  String?
  name      String?
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Configuration {
  id              Int                        @id @default(autoincrement())
  width           Int
  height          Int
  imageUrl        String
  croppedImageUrl String?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()
}
