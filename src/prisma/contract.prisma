// use prisma-8
model User {
  id              Int                        @id @default(autoincrement())
  name            String?
  firstName       String?
  lastName        String?
  username        String?                    @unique
  displayUsername String?
  email           String
  emailVerified   Boolean                    @default(false)
  image           String?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        Int                        @id @default(autoincrement())
  expiresAt DateTime
  token     String
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
  ipAddress String?
  userAgent String?
  userId    Int
  user      User                       @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    Int                        @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User                       @relation(fields:[userId], references:[id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             TimestamptzString          @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int                        @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([identifier])
  @@map("verification")
}

enum OrderStatus {
  pending
  shipped
  await_shipment
  delivered
}

enum PhoneModel {
  iphonex
  iphone11
  iphone12
  iphone13
  iphone14
  iphone15
  iphone16
  iphone17
  iphone18
}

enum CoverMaterial {
  silicone
  polycarbonate
}

enum CoverFinishing {
  smooth
  textured
}

enum CoverColor {
  black
  blue
  rose
}

model Configuration {
  id              Int                        @id @default(autoincrement())
  width           Int
  height          Int
  imageUrl        String
  userId          Int
  user            User                       @relation(fields:[userId], references:[id])
  croppedImageUrl String?
  model           PhoneModel?
  material        CoverMaterial?
  finishing       CoverFinishing?
  color           CoverColor?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()
}

model ShippingAddress {
  id          Int     @id @default(autoincrement())
  name        String
  street      String
  city        String
  state       String?
  country     String
  zipcode     String
  phoneNumber String?
  orders      Order[]
}

model BillingAddress {
  id          Int     @id @default(autoincrement())
  name        String
  street      String
  city        String
  state       String?
  country     String
  zipcode     String
  phoneNumber String?
  orders      Order[]
}

model Order {
  id                Int                        @id @default(autoincrement())
  configurationId   Int
  configuration     Configuration              @relation(fields:[configurationId], references:[id])
  userId            Int
  user              User                       @relation(fields:[userId], references:[id])
  orderTotal        Float
  isPaid            Boolean                    @default(false)
  status            OrderStatus                @default(pending)
  shippingAddressId Int?
  shippingAddress   ShippingAddress?           @relation(fields:[shippingAddressId], references:[id])
  billingAddressId  Int?
  billingAddress    BillingAddress?            @relation(fields:[billingAddressId], references:[id])

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()
}
